      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Alert share",
      "description": "Alerts as a share of scored payments, last 15 minutes.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "finplat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "finplat-prometheus"
          },
          "expr": "rate(finplat_alerts_total[15m]) / rate(finplat_scored_total[15m])",
          "legendFormat": "alert share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
