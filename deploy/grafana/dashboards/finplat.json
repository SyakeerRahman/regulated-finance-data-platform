{
  "uid": "finplat-overview",
  "title": "finplat: model, data and service",
  "description": "Generated from the file deploy/grafana/dashboards/finplat.json. Change the file, not the UI.",
  "tags": [
    "finplat"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Model",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Drift PSI by feature",
      "description": "Population stability index of each feature, live against the training data. 0.1 is moderate, 0.25 is significant.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "finplat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "finplat-prometheus"
          },
          "expr": "finplat_drift_psi{feature!=\"score\"}",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Score PSI",
      "description": "PSI of the model score. Open finding from SCRUM-44: it reads about 2.37 on the local stack.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "finplat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "finplat-prometheus"
          },
          "expr": "finplat_drift_psi{feature=\"score\"}",
          "legendFormat": "score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Payments and alerts per second",
      "description": "From the counters. A restart of the API starts them again from zero, and rate() allows for that.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "finplat-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "finplat-prometheus"
          },
          "expr": "rate(finplat_scored_total[5m])",
          "legendFormat": "scored"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "finplat-prometheus"
          },
          "expr": "rate(finplat_alerts_total[5m])",
          "legendFormat": "alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Scoring time",
      "description": "Time to score one payment, over the last 1,000 payments.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "finplat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
