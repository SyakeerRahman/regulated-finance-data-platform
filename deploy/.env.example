# Copy to .env on the server and fill in. .env is gitignored.
POSTGRES_PASSWORD=
# A git commit SHA from the image registry, or latest.
IMAGE_TAG=latest

# Off-server backups. Any S3-compatible store. See s3.sh.
# AWS S3: https://s3.<region>.amazonaws.com and the bucket's region.
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com and region auto.
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_REGION=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# The AI layer. Optional: with no key, the dashboard says the AI is off and the alerts still work.
# Any provider that accepts the OpenAI chat format. DeepSeek is the default.
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# Model calls for each UTC day. The dashboard answers 429 after that.
# LLM_DAILY_CALLS=500

# Text to vectors, for the case search. Each request counts in LLM_DAILY_CALLS.
# The base URL and the key are the chat model's unless set. DeepSeek has no embeddings, so with
# DeepSeek as the chat model, point these at OpenRouter, OpenAI or Qwen.
# EMBED_BASE_URL=https://openrouter.ai/api/v1
# EMBED_API_KEY=
# EMBED_MODEL=openai/text-embedding-3-small
# The vector length the model returns. At most 2000, the pgvector index limit.
# EMBED_DIM=1536
