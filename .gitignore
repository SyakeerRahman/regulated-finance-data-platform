# dependencies
node_modules/
.venv/
__pycache__/

# secrets
.env
.env.local

# build output
dist/
build/
.next/

# data payloads. The folder and its scripts stay in git
data/downloads/
# Delta tables written by the pipeline
data/lake/
# Model files of the local MLflow. The API and Airflow containers mount them as /mlflow.
data/mlflow/artifacts/

# Lambda build output. Exported from the model registry, not written by hand.
build/
lambda_fn/model.json

# The React build output. Built by `cd web && npm run build`.
api/static/
web/node_modules/
web/dist/

# Backups made by deploy/backup.sh. They go to the bucket, never to git.
deploy/backups/
